msgstr "Modell neve (Felhasználó által definiált címke)"

#: src/V2/Admin/Settings_Page.php:114
msgid "Custom model endpoint URL"
msgstr "Egyéni modell végpontjának URL-je"

#: src/V2/Admin/Settings_Page.php:115
msgid "API Endpoint URL"
msgstr "API végpont URL"

